# =============================================================================
# Caracal v1.0 - Environment Configuration (Boot-Time Only)
#
# Copy this file to .env and fill in values for your deployment.
# SECURITY: never commit your real .env to version control.
#
# NOTE: As of v1.0, only boot-time infrastructure vars live here.
# All runtime settings (eval models, security policies, SAML, retention, etc.)
# are configured via the Settings page in the admin UI (super admin only).
#
# No incremental upgrade from pre-1.0 is supported. See:
# https://docs.caracal.run/upgrade/1.0
# =============================================================================


# -----------------------------------------------------------------------------
# Infrastructure - required for every deployment
# The API server reads CARACAL_POSTGRES_URL / CARACAL_CLICKHOUSE_URL /
# CARACAL_REDIS_URL and accepts these bare names as fallbacks; docker-compose
# wires them into the init container from this file.
# -----------------------------------------------------------------------------

DATABASE_URL=postgresql://postgres:postgres@caracal-db:5432/caracal
CLICKHOUSE_URL=clickhouse://default:clickhouse@caracal-clickhouse:8123/caracal
REDIS_URL=redis://caracal-redis:6379


# -----------------------------------------------------------------------------
# Security
# -----------------------------------------------------------------------------

# Generate unique secrets:  openssl rand -hex 32
# REQUIRED in production: min 32 chars, random.
SECRET_KEY=change-me-to-a-random-string

# Shared secret for the API server <-> identity service bridge. REQUIRED.
AUTH_INTERNAL_SECRET=change-me-to-another-random-string

# Cookie/session signing secret for the identity service. REQUIRED.
BETTER_AUTH_SECRET=change-me-to-a-third-random-string


# -----------------------------------------------------------------------------
# Identity service (Better Auth)
# -----------------------------------------------------------------------------

# Public URL of the deployment; doubles as the JWT issuer.
BETTER_AUTH_URL=http://localhost
AUTH_TRUSTED_ORIGINS=http://localhost,http://localhost:8000

# Optional social login. Configure both halves of a pair to enable it.
# Callback URL to register with the provider: ${BETTER_AUTH_URL}/api/auth/callback/<provider>
# Google: create an OAuth client at https://console.cloud.google.com/apis/credentials
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GitHub: create an OAuth app at https://github.com/settings/developers
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=

# Optional webhook that receives outbound auth emails (reset links, invites).
# AUTH_EMAIL_WEBHOOK_URL=


# -----------------------------------------------------------------------------
# Container credentials (docker-compose only - not read by the app)
# Must match DATABASE_URL / CLICKHOUSE_URL above.
# -----------------------------------------------------------------------------

POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=clickhouse


# -----------------------------------------------------------------------------
# Development-only login (local development ONLY - never enable in production)
# The identity service enforces this server-side; the method exists only when
# ALL THREE hold: NODE_ENV is exactly "development", AUTH_DEV_LOGIN=1, and
# BETTER_AUTH_URL points at a loopback host (localhost / 127.0.0.1 / ::1).
# Production, staging, test, and public deployments can never enable it.
# On a fresh server, `caracal auth login` bootstraps the first administrator.
# -----------------------------------------------------------------------------

# AUTH_NODE_ENV=development
# AUTH_DEV_LOGIN=1

# -----------------------------------------------------------------------------
# Deployment operators (control plane at /operator)
# Comma-separated emails provisioned as deployment operators on first sign-in.
# These accounts run the hosted Caracal installation itself; everyone else is a
# plain user and can be promoted only from the operator console. In dev mode the
# local dev identity (dev@localhost.caracal) is added automatically.
# -----------------------------------------------------------------------------

# CARACAL_OPERATOR_EMAILS=rawx18.dev@gmail.com

# -----------------------------------------------------------------------------
# Active-session history retention (policy)
# How many days of ended/renewed authentication sessions the account security
# page keeps in a device's history. Active sessions are always shown; this only
# bounds how far back ended sessions remain visible. Integer 1-365, default 30.
# -----------------------------------------------------------------------------

# AUTH_SESSION_HISTORY_RETENTION_DAYS=30
