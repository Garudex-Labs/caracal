{
  "name": "caracal-auth-service",
  "version": "0.0.0",
  "private": true,
  "description": "Caracal identity service: Better Auth is the single authentication and session-management system.",
  "license": "Apache-2.0",
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "migrate": "node dist/migrate.js",
    "test": "tsx --test \"src/**/*.test.ts\"",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@better-auth/passkey": "^1.5.0",
    "@better-auth/scim": "^1.5.0",
    "@better-auth/sso": "^1.5.0",
    "better-auth": "^1.5.0",
    "pg": "^8.16.0"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "@types/pg": "^8.15.0",
    "tsx": "^4.19.0",
    "typescript": "^5.8.0"
  }
}
