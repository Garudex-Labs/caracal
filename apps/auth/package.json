{
  "name": "@caracalai/auth",
  "version": "1.0.0",
  "private": true,
  "description": "Caracal Community Edition authentication service built on Better Auth.",
  "type": "module",
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../../.env src/server.ts",
    "start": "node dist/server.js",
    "migrate": "node dist/migrate.js",
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --root ../.. tests/typescript/unit/auth",
    "lint": "eslint ."
  },
  "dependencies": {
    "@caracalai/core": "workspace:*",
    "@caracalai/server-core": "workspace:*",
    "@caracalai/engine": "workspace:*",
    "better-auth": "^1.7.1",
    "nodemailer": "^9.0.4",
    "pg": "^8.23.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.2.0",
    "@types/nodemailer": "^8.0.1",
    "@types/pg": "^8.23.1",
    "eslint": "^10.8.1",
    "globals": "^17.11.0",
    "tsx": "^4.23.12",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.67.0",
    "vitest": "^4.1.10"
  }
}
