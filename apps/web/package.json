{
  "name": "@caracalai/web",
  "version": "1.0.0",
  "private": true,
  "description": "Caracal web console and marketing surface.",
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "generate": "node scripts/generateRoutes.mjs",
    "predev": "node scripts/generateRoutes.mjs",
    "prebuild": "node scripts/generateRoutes.mjs",
    "pretypecheck": "node scripts/generateRoutes.mjs",
    "dev": "vite dev",
    "build": "vite build",
    "build:dev": "vite build --mode development",
    "preview": "vite preview",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --root ../.. tests/typescript/unit/web",
    "format": "prettier --write ."
  },
  "dependencies": {
    "@paper-design/shaders-react": "^0.0.80",
    "@tanstack/react-query": "^5.101.4",
    "@tanstack/react-router": "^1.170.31",
    "better-auth": "^1.7.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "streamdown": "2.5.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/router-generator": "^1.167.32",
    "@tanstack/router-plugin": "^1.168.34",
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.1.0",
    "eslint": "^10.8.1",
    "eslint-config-prettier": "^10.1.1",
    "eslint-plugin-prettier": "^5.2.6",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.4",
    "globals": "^17.11.0",
    "prettier": "^3.9.6",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.67.0",
    "vite": "^8.2.2",
    "vitest": "^4.1.11"
  }
