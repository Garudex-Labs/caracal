# Caracal Server Configuration
# Generated by setup.sh. Secret values live in ./secrets, not this file.

CARACAL_VERSION=latest
# Loopback is the secure default. Set an explicit private address only for an
# existing TLS proxy, or when intentional plaintext private-network access is acceptable.
CARACAL_BIND_ADDRESS=127.0.0.1
# setup.sh replaces this with the operator's group so containers can read 0640 secrets.
CARACAL_SECRET_GID=1000
FRONTEND_URL=http://localhost:8000
CORS_ALLOWED_ORIGINS=http://localhost:8000

POSTGRES_USER=postgres
POSTGRES_PASSWORD_FILE=/run/secrets/postgres_password
DATABASE_URL_FILE=/run/secrets/database_url
GRAFANA_CLICKHOUSE_PASSWORD_FILE=/run/secrets/clickhouse_password
CLICKHOUSE_URL_FILE=/run/secrets/clickhouse_url
REDIS_URL_FILE=/run/secrets/redis_url
SECRET_KEY_FILE=/run/secrets/secret_key
BETTER_AUTH_SECRET_FILE=/run/secrets/better_auth_secret
AUTH_INTERNAL_SECRET_FILE=/run/secrets/auth_internal_secret
JWT_KEY_PASSWORD_FILE=/run/secrets/jwt_key_password
GRAFANA_ADMIN_PASSWORD_FILE=/run/secrets/grafana_admin_password

# Optional file-backed credentials
# GIT_CLONE_TOKEN_FILE=/run/secrets/git_clone_token
# Social sign-in (used by the identity service; the client id is public, the
# secret is file-backed). Callback URL: ${BETTER_AUTH_URL}/api/auth/callback/<provider>
# Google: create an OAuth client at https://console.cloud.google.com/apis/credentials
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET_FILE=/run/secrets/google_client_secret
# GitHub: create an OAuth app at https://github.com/settings/developers
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET_FILE=/run/secrets/github_client_secret
# INSIGHTS_API_KEY_FILE=/run/secrets/insights_api_key
# SAML_IDP_X509_CERT_FILE=/run/secrets/saml_idp_x509_cert
# SAML_SP_PRIVATE_KEY_FILE=/run/secrets/saml_sp_private_key
# SAML_SP_X509_CERT_FILE=/run/secrets/saml_sp_x509_cert
