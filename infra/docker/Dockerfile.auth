# Identity service (Better Auth). Build from the repository root:
#   docker build -f infra/docker/Dockerfile.auth .

FROM node:22-alpine AS build
WORKDIR /app
RUN corepack enable
COPY pnpm-workspace.yaml package.json pnpm-lock.yaml ./
COPY apps/auth/package.json apps/auth/
RUN pnpm install --frozen-lockfile --filter caracal-auth-service
COPY apps/auth/tsconfig.json apps/auth/
COPY apps/auth/src apps/auth/src
RUN pnpm --filter caracal-auth-service build && \
    pnpm --filter caracal-auth-service --prod deploy --legacy /out

FROM node:22-alpine
ENV NODE_ENV=production
WORKDIR /app
RUN addgroup -S -g 10001 app && adduser -S -u 10001 -G app app
COPY --from=build /out/node_modules ./node_modules
COPY --from=build /out/package.json ./package.json
COPY --from=build /app/apps/auth/dist ./dist
USER 10001:10001
EXPOSE 8001
# Apply Better Auth schema migrations, then serve.
CMD ["sh", "-c", "node dist/migrate.js && exec node dist/index.js"]
