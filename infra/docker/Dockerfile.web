# ── Build stage: install pnpm, deps, and build the Next.js app ──────────────
# node:24-alpine (multi-arch: linux/amd64, linux/arm64, linux/s390x)
FROM node:24-alpine@sha256:f70403e87646dc51b45295f4b8b70cdad0b63d2297c4c9899119b03f7af7a6b3 AS builder
SHELL ["/bin/ash", "-eo", "pipefail", "-c"]
ARG TARGETARCH
ARG PNPM_VERSION=10.34.4
ARG PNPM_SHA256_AMD64=15092b4d71f1192f67501116dd87dd20be8c4238434371959820255a374219c1
ARG PNPM_SHA256_ARM64=9513a31bc1e166f5f6e6dbaadca91fa05b44e919ea53685c754ab0acd5501514
RUN apk add --no-cache wget && \
    case "$TARGETARCH" in \
        amd64) PNPM_ARCH=x64; PNPM_SHA256="$PNPM_SHA256_AMD64" ;; \
        arm64) PNPM_ARCH=arm64; PNPM_SHA256="$PNPM_SHA256_ARM64" ;; \
        *) echo "Unsupported architecture: $TARGETARCH" >&2; exit 1 ;; \
    esac && \
    wget -q "https://github.com/pnpm/pnpm/releases/download/v${PNPM_VERSION}/pnpm-linuxstatic-${PNPM_ARCH}" -O /usr/local/bin/pnpm && \
    echo "${PNPM_SHA256}  /usr/local/bin/pnpm" | sha256sum -c - && \
    chmod +x /usr/local/bin/pnpm

WORKDIR /app
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
COPY apps/web/package.json ./apps/web/
RUN mkdir -p tests/e2e && echo '{"name":"@caracal/e2e","version":"0.0.0","private":true,"devDependencies":{"@playwright/test":"^1.59.1"}}' > tests/e2e/package.json
RUN pnpm install --frozen-lockfile

COPY apps/web/ ./apps/web/
COPY docs/ ./docs/
WORKDIR /app/apps/web
RUN pnpm run build

# ── Runtime stage: nginx serves the static SPA build ────────────────────────
# nginx:alpine (multi-arch: linux/amd64, linux/arm64, others)
FROM nginx:alpine@sha256:4a73073bd557c65b759505da037898b61f1be6cbcc3c2c3aeac22d2a470c1752 AS runner
# NGINX_CONF selects the nginx config to bake in.
# - infra/docker/nginx-spa.conf     (default) - includes proxy_pass for Docker Compose
# - infra/docker/nginx-spa-ecs.conf            - SPA-only, no upstream (for ECS/Fargate)
ARG NGINX_CONF=infra/docker/nginx-spa.conf
COPY --from=builder /app/apps/web/dist /usr/share/nginx/html
COPY ${NGINX_CONF} /etc/nginx/conf.d/default.conf
EXPOSE 8000
CMD ["nginx", "-g", "daemon off;"]
