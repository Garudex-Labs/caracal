#
# Unified Node service image carrying the api and coordinator builds; the run command selects the role.

# syntax=docker/dockerfile:1.7
ARG PNPM_VERSION=11.1.1
ARG PNPM_INTEGRITY=sha512-0f319zxhe2T6GlaoHDyN/g6WbjOmAQqiVrUXrne+Idk+Ba/8DeGoOw5PKdVp9otEaujwaM1yR8C7PfD7TXvfmg==

FROM golang:1.27.3-alpine@sha256:fa3d596898d9f126af7c01d14ee7597bab3f39cccf392ef36b69fe77cd681f18 AS health-builder
ARG CGO_ENABLED=0
ARG GO_BUILDFLAGS
ARG GO_LDFLAGS="-s -w"
ENV CGO_ENABLED=${CGO_ENABLED} GOOS=linux
WORKDIR /healthcheck
COPY infra/healthcheck/ ./
RUN --mount=type=cache,target=/root/.cache/go-build,sharing=locked \
    --mount=type=cache,target=/go/pkg/mod,sharing=locked \
    GOWORK=off go build -mod=readonly -trimpath ${GO_BUILDFLAGS} -ldflags="${GO_LDFLAGS}" -o /healthcheck-bin ./

FROM node:26-slim@sha256:5adad64f9a1fca2d51972caa65983634c8a774eb300d72b20f7f2a0f60368072 AS builder
ARG PNPM_VERSION
ARG PNPM_INTEGRITY
ENV PNPM_HOME=/pnpm \
    PATH=/pnpm:$PATH \
    CI=1
COPY scripts/installVerifiedNpmTarball.mjs /tmp/installVerifiedNpmTarball.mjs
RUN node /tmp/installVerifiedNpmTarball.mjs pnpm "${PNPM_VERSION}" "${PNPM_INTEGRITY}" /opt/pnpm \
    && chmod 0755 /opt/pnpm/bin/pnpm.cjs \
    && ln -s /opt/pnpm/bin/pnpm.cjs /usr/local/bin/pnpm \
    && pnpm --version | grep -Fx "${PNPM_VERSION}" \
    && rm /tmp/installVerifiedNpmTarball.mjs
WORKDIR /workspace
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml .pnpmfile.cjs ./
COPY apps/api/package.json apps/api/package.json
COPY apps/coordinator/package.json apps/coordinator/package.json
COPY packages/ packages/
COPY infra/docker/runtime-compose.yml infra/docker/runtime-compose.yml
RUN --mount=type=cache,id=pnpm-store,target=/pnpm/store,sharing=locked \
    pnpm config set store-dir /pnpm/store && \
    pnpm install --frozen-lockfile --ignore-scripts \
      --filter @caracalai/api... --filter @caracalai/coordinator...
COPY apps/api/ apps/api/
COPY apps/coordinator/ apps/coordinator/
RUN set -e; \
    pnpm --filter @caracalai/core build; \
    pnpm --filter @caracalai/server-core build; \
    pnpm --filter @caracalai/admin build; \
    pnpm --filter @caracalai/oauth build; \
    pnpm --filter @caracalai/sdk build; \
    pnpm --filter @caracalai/engine build; \
    pnpm --filter @caracalai/admin-audit build; \
    pnpm --filter @caracalai/identity build; \
    pnpm --filter @caracalai/api build; \
    pnpm --filter @caracalai/coordinator build; \
    pnpm --config.inject-workspace-packages=true --filter @caracalai/api deploy --prod /out/api; \
    pnpm --config.inject-workspace-packages=true --filter @caracalai/coordinator deploy --prod /out/coordinator; \
    find /out -type d \( -name test -o -name tests -o -name __tests__ \) -prune -exec rm -rf {} + 2>/dev/null || true; \
    find /out -type f \( -name '*.md' -o -name '*.markdown' -o -name '*.map' -o -name 'CHANGELOG*' -o -name '.npmignore' -o -name '.eslintrc*' -o -name '.prettierrc*' -o -name 'pnpm-lock.yaml' -o -name 'pnpm-workspace.yaml' \) ! -iname '*license*' ! -iname '*notice*' -delete 2>/dev/null || true

FROM gcr.io/distroless/nodejs24-debian13:nonroot@sha256:088a01637f22908632ba09018be2e0b516f2fa6f7869c191d29491139db43c78
ENV NODE_ENV=production \
    NODE_OPTIONS=--enable-source-maps \
    NPM_CONFIG_UPDATE_NOTIFIER=false \
    HEALTH_PATH=/ready
WORKDIR /app
COPY --from=builder --chown=nonroot:nonroot /out/api ./api
COPY --from=builder --chown=nonroot:nonroot /out/coordinator ./coordinator
COPY --from=health-builder /healthcheck-bin /healthcheck
USER nonroot
HEALTHCHECK --interval=10s --timeout=3s --start-period=20s --retries=3 \
    CMD ["/healthcheck"]
