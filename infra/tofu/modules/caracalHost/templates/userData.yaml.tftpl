#cloud-config
# Copyright (C) 2026 Garudex Labs.  All Rights Reserved.
# Caracal, a product of Garudex Labs
#
# First-boot bootstrap: install Docker and the Caracal runtime CLI, then start the pinned stack.
package_update: true
packages:
  - ca-certificates
  - curl
write_files:
%{ if length(envLines) > 0 ~}
  - path: ${caracalHome}/caracal.env
    permissions: "0600"
    content: |
%{ for line in envLines ~}
      ${line}
%{ endfor ~}
%{ endif ~}
%{ if caddyfile != "" ~}
  - path: ${caracalHome}/proxy/Caddyfile
    permissions: "0644"
    content: |
%{ for line in split("\n", caddyfile) ~}
      ${line}
%{ endfor ~}
%{ endif ~}
  # One strict-mode script instead of independent runcmd entries: any failed step
  # aborts the boot visibly instead of leaving a half-started host that looks done.
  - path: /usr/local/lib/caracalBootstrap.sh
    permissions: "0700"
    content: |
      #!/bin/sh
      set -eu
      # Download separately so a failed curl cannot look like an empty shell
      # succeeding. Hardened images should preinstall Docker.
      installers="$(mktemp -d)"
      trap 'rm -rf "$installers"' EXIT
      if ! command -v docker >/dev/null 2>&1; then
        curl --fail --silent --show-error --location --proto '=https' --proto-redir '=https' https://get.docker.com -o "$installers/docker.sh"
        sh "$installers/docker.sh"
      fi
      systemctl enable --now docker
      id caracal >/dev/null 2>&1 || useradd --system --home-dir ${caracalHome} --shell /usr/sbin/nologin caracal
      usermod -aG docker caracal
      mkdir -p ${caracalHome}
      chown -R caracal:caracal ${caracalHome}
      curl --fail --silent --show-error --location --proto '=https' --proto-redir '=https' '${installScriptUrl}' -o "$installers/caracal.sh"
      CARACAL_INSTALL_DIR=/usr/local/bin CARACAL_REQUIRE_PROVENANCE=${requireProvenance ? 1 : 0} sh "$installers/caracal.sh" --version ${caracalVersion}
%{ for email in operatorEmails ~}
      runuser -u caracal -- env HOME=${caracalHome} CARACAL_HOME=${caracalHome} /usr/local/bin/caracal allowlist add '${email}'
%{ endfor ~}
%{ for cmd in extraRuncmd ~}
      ${cmd}
%{ endfor ~}
      runuser -u caracal -- env HOME=${caracalHome} CARACAL_HOME=${caracalHome} /usr/local/bin/caracal up
%{ if caddyfile != "" ~}
      # Host networking answers on 443 while reaching the stack on loopback.
      # Certificate issuance needs inbound 80 and 443 open in the cloud firewall.
      docker run -d --name caracalProxy --restart unless-stopped --network host -v ${caracalHome}/proxy/Caddyfile:/etc/caddy/Caddyfile:ro -v caracalProxyData:/data -v caracalProxyConfig:/config ${proxyImage}
%{ endif ~}
      attempt=0
      until runuser -u caracal -- env HOME=${caracalHome} CARACAL_HOME=${caracalHome} /usr/local/bin/caracal status --ready >/dev/null 2>&1; do
        attempt=$((attempt + 1))
        if [ "$attempt" -ge 60 ]; then
          echo "caracal stack not ready after 10 minutes" >&2
          exit 1
        fi
        sleep 10
      done
runcmd:
  # The marker file records the boot outcome, so operators and automation check
  # one path instead of parsing cloud-init logs.
  - sh -c '/usr/local/lib/caracalBootstrap.sh >>/var/log/caracalBootstrap.log 2>&1 && echo ok >${caracalHome}/bootstrapStatus || { echo failed >${caracalHome}/bootstrapStatus; exit 1; }'
