    "@react-three/drei": "^10.7.7",
    "@react-three/fiber": "^9.7.0",
    "astro": "^7.2.9",
    "mermaid": "^11.17.2",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "remark-gfm": "4.0.1",
    "starlight-versions": "0.10.1",
    "three": "^0.185.1"
  },
  "devDependencies": {
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4"
